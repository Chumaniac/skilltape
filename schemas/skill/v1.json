{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skilltape.dev/schemas/skill/v1.json",
  "type": "object",
  "required": ["schema", "name", "version", "description", "engine", "entrypoint", "inputs", "outputs", "targets"],
  "properties": {
    "schema": { "const": "skilltape.dev/skill/v1" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "engine": { "$ref": "#/$defs/engine" },
    "entrypoint": { "$ref": "#/$defs/entrypoint" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
    "targets": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "$defs": {
    "engine": {
      "type": "object",
      "required": ["min_version"],
      "properties": { "min_version": { "type": "string", "minLength": 1 } },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "entrypoint": {
      "type": "object",
      "required": ["workflow", "permissions", "lockfile"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "permissions": { "type": "string", "minLength": 1 },
        "lockfile": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["id", "type", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["id", "type", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    }
  }
}
