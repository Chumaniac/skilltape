{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skilltape.dev/schemas/replay/v1.json",
  "type": "object",
  "required": ["schema", "status", "steps", "policy_decisions", "output_truncated"],
  "properties": {
    "schema": { "const": "skilltape.dev/replay/v1" },
    "status": { "type": "string", "enum": ["succeeded", "failed", "cancelled"] },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "policy_decisions": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "output_truncated": { "type": "boolean" },
    "failure": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "step": {
      "type": "object",
      "required": ["step_id", "status", "exit_code", "stdout_sha256", "stdout_bytes", "stdout_truncated", "stderr_sha256", "stderr_bytes", "stderr_truncated"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["succeeded", "failed", "denied", "timed_out", "cancelled", "spawn_failed"] },
        "exit_code": { "type": ["integer", "null"] },
        "stdout_sha256": { "$ref": "#/$defs/digest" },
        "stdout_bytes": { "type": "integer", "minimum": 0 },
        "stdout_truncated": { "type": "boolean" },
        "stderr_sha256": { "$ref": "#/$defs/digest" },
        "stderr_bytes": { "type": "integer", "minimum": 0 },
        "stderr_truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["step_id", "phase", "allowed", "code", "reason", "risk"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "enum": ["before", "after"] },
        "allowed": { "type": "boolean" },
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["kind", "step_id", "status"],
      "properties": {
        "kind": { "type": "string", "enum": ["policy_denied", "step_failed"] },
        "step_id": { "type": "string", "minLength": 1 },
        "status": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
