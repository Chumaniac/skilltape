{
  "schema": "skilltape.dev/permissions/v1",
  "filesystem": {
    "read": [
      "scripts/write-message.pl"
    ],
    "write": [
      "fixtures/output/message.txt"
    ]
  },
  "process": {
    "executables": [
      "/usr/bin/perl"
    ],
    "max_processes": 1,
    "default_timeout_ms": 120000
  },
  "network": {
    "enabled": false,
    "allow_hosts": []
  },
  "secrets": {
    "read_environment": false
  }
}
