{
  "schema": "skilltape.dev/permissions/v1",
  "filesystem": {
    "read": [
      "inputs/sample.txt"
    ],
    "write": [
      "message.txt"
    ]
  },
  "process": {
    "executables": [
      "/bin/cp"
    ],
    "max_processes": 1,
    "default_timeout_ms": 120000
  },
  "network": {
    "enabled": false,
    "allow_hosts": []
  },
  "secrets": {
    "read_environment": false
  }
}
