{
  "schema": "skilltape.dev/permissions/v1",
  "filesystem": {
    "read": [
      "inputs/note.md",
      "inputs/source.md",
      "outputs/knowledge/note.md",
      "outputs/knowledge/source.md"
    ],
    "write": [
      "outputs/knowledge/note.md",
      "outputs/knowledge/source.md"
    ]
  },
  "process": {
    "executables": [],
    "max_processes": 1,
    "default_timeout_ms": 1000
  },
  "network": {
    "enabled": false,
    "allow_hosts": []
  },
  "secrets": {
    "read_environment": false
  }
}
