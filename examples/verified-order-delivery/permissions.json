{
  "schema": "skilltape.dev/permissions/v1",
  "filesystem": {
    "read": [
      "inputs/orders.csv",
      "scripts/summarize_orders.pl",
      "outputs/metrics.csv",
      "outputs/summary.json"
    ],
    "write": [
      "outputs/metrics.csv",
      "outputs/summary.json"
    ]
  },
  "process": {
    "executables": [
      "/usr/bin/perl"
    ],
    "max_processes": 1,
    "default_timeout_ms": 3000
  },
  "network": {
    "enabled": false,
    "allow_hosts": []
  },
  "secrets": {
    "read_environment": false
  }
}
