{
  "version": 1,
  "name": "SkillTape",
  "identifier": "com.chumaniac.skilltape",
  "mark": "ST",
  "port": 19001,
  "smokePort": 19011,
  "mode": "process",
  "workspaceSelectable": true,
  "readySelector": "main",
  "launch": {
    "executable": "{{RESOURCES}}/runtime/bin/skilltape-console-api",
    "arguments": [
      "--workspace",
      "{{WORKSPACE}}",
      "--port",
      "19001",
      "--static-root",
      "{{RESOURCES}}/ui"
    ],
    "workingDirectory": "{{RESOURCES}}/runtime",
    "healthPath": "",
    "healthMarker": "SkillTape",
    "stopOnQuit": true,
    "smokeArguments": [
      "--workspace",
      "{{SMOKE_DIR}}",
      "--port",
      "19011",
      "--static-root",
      "{{RESOURCES}}/ui"
    ],
    "workspaceDirectory": "{{HOME}}/Library/Application Support/SkillTape/workspace"
  },
  "saveSelector": "[data-desktop-save]",
  "product": "skilltape",
  "assets": "apps/skilltape-console/dist"
}
